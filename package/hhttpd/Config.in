comment "hhttpd needs a toolchain w/ C++, wchar, dynamic library, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_USE_WCHAR || \
		BR2_STATIC_LIBS || !BR2_TOOLCHAIN_HAS_THREADS

config BR2_PACKAGE_HHTTPD
	bool "hhttpd"
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_WCHAR
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_HOST_HHTTPD
	help
	  HCppBox hhttpd

	  https://git.hyhsystem.cn/HEYAHONG/HCppBox

if BR2_PACKAGE_HHTTPD

config BR2_PACKAGE_HHTTPD_OPENSSL
	bool "openssl support"
	default y
	select BR2_PACKAGE_OPENSSL
	help
	  Enable HTTPS support using OpenSSL.

endif
