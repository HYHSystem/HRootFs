# 仅在 sparc_ss10 配置中启用（通过 BR2_PACKAGE_OVERRIDE_FILE 引用）。
# HBox/HCppBox 使用 C/C++ 原子操作，sparc 没有原生 4 字节原子指令，
# 需要显式链接 libatomic。
HTOOLS_ATOMIC_PATCH = $(TOPDIR)/board/hrootfs/qemu/sparc_ss10/0001-hbox-link-libatomic.patch

define HTOOLS_LINK_LIBATOMIC
	grep -q 'target_link_libraries(HBox atomic)' $(@D)/hbox/CMakeLists.txt || \
		patch -d $(@D) -p1 < $(HTOOLS_ATOMIC_PATCH)
endef

HASHTOOL_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HCRCTABLEGENERATE_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HED25519SIGN_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HGZIP_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HHTTP_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HHTTPD_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HLZ4_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HMINI_MCS51_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HMINI_RV32IMA_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HMINI_RV32IMAV2_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HSNTP_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
HSNTPD_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
DUMPPLCDLL_POST_RSYNC_HOOKS += HTOOLS_LINK_LIBATOMIC
