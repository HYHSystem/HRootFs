comment "hmodbustcpgateway needs a toolchain w/ C++, wchar, dynamic library, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_USE_WCHAR || \
		BR2_STATIC_LIBS || !BR2_TOOLCHAIN_HAS_THREADS

config BR2_PACKAGE_HMODBUSTCPGATEWAY
	bool "hmodbustcpgateway"
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_WCHAR
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBSERIALPORT
	select BR2_PACKAGE_LIBEVENT
	select BR2_PACKAGE_HOST_HMODBUSTCPGATEWAY
	help
	  HCppBox hmodbustcpgateway

	  https://git.hyhsystem.cn/HEYAHONG/HCppBox
